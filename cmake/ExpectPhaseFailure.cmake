execute_process(COMMAND "${PROGRAM}" ${ARGS} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result MATCHES "^[0-9]+$" OR result EQUAL 0)
  message(FATAL_ERROR "Mutant did not fail normally: ${result}\n${out}\n${err}")
endif()
string(FIND "${err}" "${EXPECTED}" found)
if(found EQUAL -1)
  message(FATAL_ERROR "Mutant failed for the wrong reason: ${out}\n${err}")
endif()
message(STATUS "Compiled mutant rejected: ${EXPECTED}")
